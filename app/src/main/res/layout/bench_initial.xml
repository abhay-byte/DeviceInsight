<?xml version="1.0" encoding="utf-8"?>
<!-- First-paint layout for all BENCH widgets: styled CALIBRATING frame instead of the
     Glance spinner — matches BenchPanel paper/carbon tokens so fresh adds never flash. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bench_panel">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="CALIBRATING…"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:textColor="@color/bench_ink60" />
</FrameLayout>
